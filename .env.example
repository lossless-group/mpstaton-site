SITE_BRAND=mpstaton
SITE_MODE=dark

# OpenPanel analytics
OPENPANEL_CLIENT_ID=replace-me-with-openpanel-client-id

# /promote — investment-opportunity surface
# Generate with: openssl rand -hex 32
PROMOTE_SESSION_SECRET=replace-me-with-a-32-byte-hex-string

# Hash with: node -e "import('node:crypto').then(c => console.log(c.scryptSync(process.argv[1], 'mpstaton-promote-salt', 64).toString('hex')))" 'your-master-code'
PROMOTE_MASTER_CODE_HASH=replace-me-with-a-scrypt-hash

# Optional JSON map of slug → scrypt hash for per-opportunity overrides.
# PROMOTE_OVERRIDE_CODES_JSON={"aurora":"<scrypt-hash>"}
PROMOTE_OVERRIDE_CODES_JSON=

# Local-dev convenience: when set to "1", any code is accepted. Never set in production.
PROMOTE_DEV_BYPASS=0

# ── /portfolio — track-record markup columns (Multiple, Valuation) ──
# Optional. Falls back to PROMOTE_SESSION_SECRET when unset.
PORTFOLIO_SESSION_SECRET=

# Hash with: node -e "import('node:crypto').then(c => console.log(c.scryptSync(process.argv[1], 'mpstaton-track-record-salt', 64).toString('hex')))" 'your-passcode'
# Single-quote the passcode — a $ in it is shell-interpolated inside double quotes.
PORTFOLIO_MARKUPS_CODE_HASH=replace-me-with-a-scrypt-hash

# The markup figures themselves, as JSON: {"deals":{"<id>":{"multiple","relevantValuation"}},"funds":{...}}
# REQUIRED IN PRODUCTION. Locally this is read from the gitignored
# src/data/track-record/private/markups.json instead, so it can stay empty here.
# Regenerate the one-line value with:
#   node -e "console.log(JSON.stringify(require('./src/data/track-record/private/markups.json')))"
TRACK_RECORD_MARKUPS_JSON=

# Local-dev convenience: when set to "1", any code unlocks the markup columns.
# Honoured ONLY when running `astro dev` — it has no effect in production.
PORTFOLIO_DEV_BYPASS=0
