ignore-workspace=true
# Treat this project as standalone — do not try to discover or use the
# parent astro-knots workspace. Critical for Vercel: without this, pnpm
# would error out looking for pnpm-workspace.yaml. The site stays
# standalone in both lfm:local and lfm:jsr modes — local mode uses a
# relative `link:` path to /Users/mpstaton/code/lossless-monorepo/lfm
# rather than going through the workspace.

# Hoist dependencies into a flat node_modules so packages that expect a
# classic node_modules layout (some Vite/Rollup/Astro plugins) work.
shamefully-hoist=true

# Auto-install peer dependencies so we don't have to enumerate them.
auto-install-peers=true

# Don't fail builds on peer-dependency mismatches.
strict-peer-dependencies=false

# JSR registry — required to resolve @jsr/* aliased deps like
# @lossless-group/lfm (published at jsr.io/@lossless-group/lfm and consumed
# via the npm alias `npm:@jsr/lossless-group__lfm@…` in package.json).
# Public registry, no auth token needed — works the same in dev and on Vercel.
@jsr:registry=https://npm.jsr.io
