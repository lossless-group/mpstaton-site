node_modules/
dist/
.astro/
.vercel/
.env

# Context-V fetcher
src/content/context-v/
.context-v-cache/

# Essays fetcher
src/content/essays/
.essays-cache/

# LFM Open Graph fetch cache (regenerated on build, keyed by URL hash)
src/data/og-cache.json

# /promote — opportunity content is local-only (this is a public repo).
# Convention:
#   • directories prefixed with `_` ARE committed (templates, scaffolding, demo)
#   • directories with real opportunity slugs (e.g. chromadb, acme) are NOT committed
src/content/promote/*/
!src/content/promote/_*/
src/layouts/sections/promote/*/
!src/layouts/sections/promote/_*/
public/promote/*/
!public/promote/_*/
