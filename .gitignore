node_modules/
dist/
.astro/
.vercel/
.env

# Context-V fetcher
src/content/context-v/
.context-v-cache/

# Essays fetcher
src/content/essays/
.essays-cache/

# LFM Open Graph fetch cache (regenerated on build, keyed by URL hash)
src/data/og-cache.json

# YouTube playlist data cache (regenerated on build, keyed by playlist ID)
src/data/youtube-playlist-cache.json

# /promote — opportunity content is local-only (this is a public repo).
# Convention:
#   • directories prefixed with `_` ARE committed (templates, scaffolding, demo)
#   • directories with real opportunity slugs (e.g. chromadb, acme) are NOT committed
src/content/promote/*/
!src/content/promote/_*/
src/layouts/sections/promote/*/
!src/layouts/sections/promote/_*/
public/promote/*/
!public/promote/_*/

# Track-record markups — local-only (this is a public repo).
# deals.json / funds.json carry the public track record and stay committed;
# `multiple` and `relevantValuation` live here and are joined back by `id` at
# render time, only for a request that cleared the /portfolio passcode gate.
# Production reads the same payload from the TRACK_RECORD_MARKUPS_JSON env var,
# because a gitignored file does not exist on the Vercel builder.
src/data/track-record/private/

# context-v scratch — out-of-band material, never committed
context-v/extra/
