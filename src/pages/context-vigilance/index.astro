---
import { getCollection } from 'astro:content';
import { humanizeTerm } from '../../utils/humanize-term';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocCard from '../../components/context-v/DocCard.astro';

const allDocs = await getCollection('context-v');

/**
 * Filter by the context-v directory a document came from, NOT by its
 * frontmatter `category`.
 *
 * The directory is structural — a doc under specs/ is a spec, and the fetcher
 * only pulls the directories context-v-sources.yaml lists, so the set is
 * closed and every doc has exactly one. `category` is free text maintained by
 * hand across repos and has drifted accordingly: "Specification" and
 * "Specifications" both appear, alongside one-off values like "Components",
 * "Marketing-Site" and "UI-Design". Eighteen documents carried a category that
 * matched no tab, so they rendered under All and were reachable from no
 * filter at all. Grouping by folder cannot produce that state.
 */
const FOLDER_ORDER = ['specs', 'blueprints', 'prompts', 'reminders', 'sitemap'];
const FOLDER_LABELS: Record<string, string> = {
  specs: 'Specs',
  blueprints: 'Blueprints',
  prompts: 'Prompts',
  reminders: 'Reminders',
  sitemap: 'Sitemap',
};

function folderOf(doc: (typeof allDocs)[number]): string {
  // `context-v/specs/Foo.md` -> `specs`; nested paths keep their top folder,
  // so `context-v/sitemap/pages/team/Foo.md` is still `sitemap`.
  const filePath = doc.data._context_v?.file_path;
  if (filePath) {
    const parts = filePath.split('/');
    if (parts.length > 2) return parts[1];
  }
  // Fallback for anything without provenance: the id is `<repo>/<folder>/...`
  const idParts = doc.id.split('/');
  return idParts.length > 1 ? idParts[1] : 'other';
}

const byCategory = new Map<string, typeof allDocs>();
for (const doc of allDocs) {
  const folder = folderOf(doc);
  if (!byCategory.has(folder)) byCategory.set(folder, []);
  byCategory.get(folder)!.push(doc);
}

// Configured folders first in their canonical order, then anything unexpected
// alphabetically — a new upstream directory shows up rather than vanishing.
const categories = [
  ...FOLDER_ORDER.filter((f) => byCategory.has(f)),
  ...[...byCategory.keys()].filter((f) => !FOLDER_ORDER.includes(f)).sort(),
];

// Sort each category by date_modified or date_created descending
for (const [, docs] of byCategory) {
  docs.sort((a, b) => {
    const dateA = a.data.date_modified || a.data.date_created || a.data.date_authored_current_draft || a.data.date_authored_initial_draft || a.data.date_authored_current_draft || a.data.date_authored_initial_draft || a.data.date_authored_current_draft || a.data.date_authored_initial_draft || '';
    const dateB = b.data.date_modified || b.data.date_created || b.data.date_authored_current_draft || b.data.date_authored_initial_draft || b.data.date_authored_current_draft || b.data.date_authored_initial_draft || b.data.date_authored_current_draft || b.data.date_authored_initial_draft || '';
    return dateB.localeCompare(dateA);
  });
}

const totalDocs = allDocs.length;
const repoCount = new Set(allDocs.map(d => d.data._context_v?.repo_label).filter(Boolean)).size;
---

<BaseLayout title="Rabbit Holes — Context Vigilance" description="Project documentation across multiple repositories. Specs, Blueprints, Prompts, Reminders, and Sitemaps.">

  <!-- Hero: half above-the-fold -->
  <section class="flex items-center justify-center px-6" style="min-height: 45vh;">
    <div class="text-center max-w-2xl">
      <h1 class="gradient-text mb-4">Rabbit Holes</h1>
      <p class="text-lg text-muted-foreground">
        {totalDocs} documents across {repoCount} {repoCount === 1 ? 'project' : 'projects'}. Specs, blueprints, prompts, and reminders — the living documentation behind everything I build.
      </p>
    </div>
  </section>

  <!-- Category nav + content -->
  <section class="max-w-5xl mx-auto px-6 pb-16">

    <!-- Category filter tabs -->
    <nav class="flex gap-2 mb-8 flex-wrap justify-center" id="category-nav">
      <button
        data-filter="all"
        class="category-tab active px-4 py-2 rounded-full text-sm font-medium border border-border transition-colors"
      >
        All ({totalDocs})
      </button>
      {categories.map(cat => {
        const count = byCategory.get(cat)?.length || 0;
        if (count === 0) return null;
        return (
          <button
            data-filter={cat}
            class="category-tab px-4 py-2 rounded-full text-sm font-medium border border-border transition-colors"
          >
            {FOLDER_LABELS[cat] ?? humanizeTerm(cat)} ({count})
          </button>
        );
      })}
    </nav>

    <!-- Document list -->
    <div class="grid gap-3" id="doc-list">
      {allDocs
        .sort((a, b) => {
          const dateA = a.data.date_modified || a.data.date_created || a.data.date_authored_current_draft || a.data.date_authored_initial_draft || a.data.date_authored_current_draft || a.data.date_authored_initial_draft || a.data.date_authored_current_draft || a.data.date_authored_initial_draft || '';
          const dateB = b.data.date_modified || b.data.date_created || b.data.date_authored_current_draft || b.data.date_authored_initial_draft || b.data.date_authored_current_draft || b.data.date_authored_initial_draft || b.data.date_authored_current_draft || b.data.date_authored_initial_draft || '';
          return dateB.localeCompare(dateA);
        })
        .map(doc => (
          <div data-category={folderOf(doc)}>
            <DocCard
              title={doc.data.title}
              lede={doc.data.lede}
              category={doc.data.category}
              tags={doc.data.tags}
              repo_label={doc.data._context_v?.repo_label}
              github_url={doc.data._context_v?.github_url}
              href={`/context-vigilance/${doc.id}`}
            />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .category-tab {
    cursor: pointer;
    background: transparent;
    color: var(--muted-foreground);
  }
  .category-tab:hover {
    border-color: var(--primary);
    color: var(--foreground);
  }
  .category-tab.active {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }
</style>

<script>
  const nav = document.getElementById('category-nav');
  const list = document.getElementById('doc-list');
  if (nav && list) {
    nav.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.category-tab') as HTMLButtonElement | null;
      if (!btn) return;

      const filter = btn.dataset.filter;

      // Update active tab
      nav.querySelectorAll('.category-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');

      // Filter cards
      list.querySelectorAll('[data-category]').forEach(card => {
        const el = card as HTMLElement;
        if (filter === 'all' || el.dataset.category === filter) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  }
</script>
