---
import PromotionDeckLayout from '../../../../../layouts/PromotionDeckLayout.astro';
import { getOpportunity } from '../../../../../lib/promote/opportunities';
import { loadSections } from '../../../../../lib/promote/sections';
import { hubUrl, parseVersionParam } from '../../../../../lib/promote/urls';
import type { DeckFormat } from '../../../../../lib/promote/types';

export const prerender = false;

const { slug, format, version } = Astro.params;
if (!slug || !format || !version) return Astro.redirect('/promote');

const opportunity = getOpportunity(slug);
if (!opportunity) return new Response('Not found', { status: 404 });

const validFormats: DeckFormat[] = ['scroll', 'static', 'interactive'];
if (!validFormats.includes(format as DeckFormat)) {
  return Astro.redirect(hubUrl(slug));
}

const versionNumber = parseVersionParam(version);
if (versionNumber === null) {
  return Astro.redirect(hubUrl(slug));
}

const sections = await loadSections(slug, format as DeckFormat, versionNumber);
if (sections.length === 0) {
  return new Response(`No sections found for ${slug}/${format}/v${versionNumber}`, { status: 404 });
}

const title = `${opportunity.company_name} — ${format} deck v${versionNumber}`;
---
<PromotionDeckLayout opportunity={opportunity} title={title} description={opportunity.short_description}>
  {sections.map(({ Component }) => <Component />)}
</PromotionDeckLayout>
