---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OpportunityCard from '../../components/promote/OpportunityCard.astro';
import { getListedOpportunities } from '../../lib/promote/opportunities';

export const prerender = false;

const opportunities = getListedOpportunities();
const active = opportunities.filter(o => o.status !== 'closed');
const closed = opportunities.filter(o => o.status === 'closed');

const meta = {
  title: 'Promote — Investment Opportunities · Michael P. Staton',
  description: 'Active investment opportunities and syndicates being promoted to a small group of co-investors.',
  type: 'website' as const,
};
---
<BaseLayout title={meta.title} description={meta.description} meta={meta}>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <header class="mb-10">
      <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Promote</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-foreground">Investment opportunities</h1>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        A handful of opportunities I'm actively promoting to other VCs and syndicate co-investors.
        Each is gated — if you have a code, click through to view materials.
      </p>
    </header>

    {active.length === 0 && closed.length === 0 && (
      <div class="rounded-lg border border-dashed border-border p-12 text-center">
        <p class="text-muted-foreground">No opportunities currently being promoted.</p>
      </div>
    )}

    {active.length > 0 && (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {active.map((o) => <OpportunityCard opportunity={o} />)}
      </div>
    )}

    {closed.length > 0 && (
      <div class="mt-16">
        <h2 class="mb-4 text-sm uppercase tracking-[0.18em] text-muted-foreground">Closed</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {closed.map((o) => <OpportunityCard opportunity={o} />)}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
