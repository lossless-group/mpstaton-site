---
/**
 * /hype-machine/[investment] — the company profile.
 *
 * Company-forward, and deliberately NOT the memo. This page answers "what is
 * this company and why is Michael talking about it" in about fifteen seconds,
 * then hands off: out to the company's own site, or across to /investments
 * for the full write-up.
 *
 * The memo body is intentionally absent. Duplicating it here would make the
 * two surfaces genuinely identical rather than usefully redundant, and the
 * memos are headed behind a passcode while this page stays public.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createLfmProcessor } from '@lossless-group/lfm';
import AstroMarkdown from '../../components/markdown/AstroMarkdown.astro';
import { getAllInvestments, getInvestment } from '../../lib/investments/companies';
import { formatDate, toIsoDate } from '../../utils/format-date';
import { humanizeTerm } from '../../utils/humanize-term';

export const prerender = true;

export async function getStaticPaths() {
  const all = await getAllInvestments();
  // Every company gets a profile, not just the hyped ones — an un-hyped memo
  // still has a shareable company page, it just isn't listed on the index.
  return all.map((investment) => ({ params: { investment: investment.slug } }));
}

const { investment: slug } = Astro.params;
const company = await getInvestment(slug!);

if (!company) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// The hype surface renders `hype_note` — the enthusiastic read — and never
// `my_take`, which carries the reservations and the verdict and lives on
// /investments beside the analysis that earned it.
//
// It is authored as markdown (inline emphasis, the occasional code span), so
// it runs through the same LFM pipeline the memos do rather than rendering as
// escaped plain text.
const takeTree = company.hypeNote
  ? await (async () => {
      const p = createLfmProcessor();
      return p.run(p.parse(company.hypeNote!));
    })()
  : null;

// NO SCORECARD ON THIS SURFACE. `verdict`, `score` and the memo's draft
// `status` are deliberately absent — a "CONSIDER · 3.1/5.0" chip undercuts the
// page it sits on. They render on /investments, beside the analysis that
// earned them. `stage` is context rather than judgement, so it stays as the
// header chip.

const meta = {
  title: `${company.companyName} · Hype Machine`,
  description: company.zinger ?? company.lede,
  // The company's own OG image when we have one — an unfurl of this page
  // should look like the company, not like a generic site card.
  image: company.og.image,
  type: 'article' as const,
};
---

<BaseLayout title={meta.title} description={meta.description} meta={meta}>
  <div class="mx-auto max-w-4xl px-6 py-8">
    <a
      href="/hype-machine"
      class="mb-8 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to Hype Machine
    </a>

    <header class="mb-10" style={company.accentColor ? `--page-accent: ${company.accentColor};` : undefined}>
      {company.og.image && (
        <img
          src={company.og.image}
          alt={`${company.companyName} — OpenGraph preview`}
          class="mb-6 w-full rounded-lg border border-border object-cover"
          style="aspect-ratio: 1200 / 630;"
          loading="eager"
        />
      )}

      <div class="mb-3 flex flex-wrap items-center gap-3">
        <h1 class="gradient-text">{company.companyName}</h1>
        {company.stage && (
          <span class="rounded-full border border-border bg-muted px-2.5 py-1 text-xs text-muted-foreground">
            {company.stage}
          </span>
        )}
      </div>

      {company.zinger && (
        <p class="mb-5 text-lg leading-relaxed text-muted-foreground">{company.zinger}</p>
      )}

      <div class="flex flex-wrap items-center gap-4 border-y border-border py-3 text-sm">
        {company.companyUrl && (
          <a
            href={company.companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-medium text-primary hover:underline"
          >
            {company.faviconUrl && <img src={company.faviconUrl} alt="" width="16" height="16" class="rounded-sm" />}
            {company.host}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        )}
        {company.dateAuthored && (
          <span class="text-muted-foreground">
            Reviewed <time datetime={toIsoDate(company.dateAuthored)}>{formatDate(company.dateAuthored)}</time>
          </span>
        )}
      </div>

      {company.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {company.tags.map((tag) => (
            <span class="rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">
              {humanizeTerm(tag)}
            </span>
          ))}
        </div>
      )}
    </header>

    {takeTree && (
      <section class="hype-note mb-10">
        <h2 class="hype-note__label">Why it matters</h2>
        <div class="prose">
          <AstroMarkdown node={takeTree} />
        </div>
      </section>
    )}

    {company.og.description && (
      <section class="mb-10">
        <h2 class="mb-2 text-sm font-semibold uppercase tracking-[0.14em] text-muted-foreground">
          How they describe themselves
        </h2>
        <blockquote class="border-l-2 border-border pl-4 text-muted-foreground italic">
          {company.og.description}
          {company.host && (
            <cite class="mt-2 block text-xs not-italic opacity-70">— {company.host}</cite>
          )}
        </blockquote>
      </section>
    )}

    <nav class="flex flex-wrap gap-3 border-t border-border pt-6">
      <a
        href={`/investments/${company.slug}`}
        class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary"
      >
        Read the full investment memo
        <span aria-hidden="true">→</span>
      </a>
      {company.companyUrl && (
        <a
          href={company.companyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-border px-4 py-2.5 text-sm text-muted-foreground transition-colors hover:border-primary hover:text-primary"
        >
          Visit {company.host}
        </a>
      )}
    </nav>
  </div>
</BaseLayout>

<style>
  .hype-note {
    --page-accent: var(--color-primary, var(--primary));
    border-left: 3px solid var(--page-accent);
    padding-left: 1.25rem;
  }

  .hype-note__label {
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--page-accent);
  }
</style>
