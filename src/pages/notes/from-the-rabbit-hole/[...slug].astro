---
import { getCollection } from 'astro:content';
import { createLfmProcessor } from '@lossless-group/lfm';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AstroMarkdown from '../../../components/markdown/AstroMarkdown.astro';
import Sources from '../../../components/markdown/Sources.astro';
import { remarkLosslessWikilinksLocal } from '../../../lib/remark-lossless-wikilinks-local';
import { formatDate, toIsoDate } from '../../../utils/format-date';
import { humanizeTerm } from '../../../utils/humanize-term';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/notes/from-the-rabbit-hole');

const allNotes = await getCollection('notes');
const entry = allNotes.find((note) => note.id === slug);

if (!entry) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { data } = entry;
const processor = createLfmProcessor().use(remarkLosslessWikilinksLocal);
const tree = await processor.run(processor.parse(entry.body));
const citations = (tree as any).data?.citations?.ordered ?? [];
---

<BaseLayout title={data.title || 'Note'} description={data.lede}>
  <div class="max-w-4xl mx-auto px-6 py-8">

    <a href="/notes/from-the-rabbit-hole" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Back to From the Rabbit Hole
    </a>

    <header class="mb-10">
      <h1 class="gradient-text mb-4">{data.title}</h1>

      {data.lede && (
        <p class="text-lg text-muted-foreground leading-relaxed mb-6">{data.lede}</p>
      )}

      <div class="flex items-center gap-4 flex-wrap text-sm text-muted-foreground border-t border-b border-border py-3">
        {data.authors && data.authors.length > 0 && (
          <span>{data.authors.join(', ')}</span>
        )}
        {data.date_modified && (
          <span>Updated <time datetime={toIsoDate(data.date_modified)}>{formatDate(data.date_modified)}</time></span>
        )}
      </div>

      {data.tags && data.tags.length > 0 && (
        <div class="flex gap-1.5 flex-wrap mt-3">
          {data.tags.map((tag: string) => (
            <span class="text-xs px-2 py-0.5 rounded bg-muted text-muted-foreground">
              {humanizeTerm(tag)}
            </span>
          ))}
        </div>
      )}
    </header>

    <article class="prose">
      <AstroMarkdown node={tree} />
    </article>

    <Sources citations={citations} />

  </div>
</BaseLayout>
