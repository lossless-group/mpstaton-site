---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const allNotes = await getCollection('notes');

// Sort by date_modified descending
allNotes.sort((a, b) => {
  const dateA = a.data.date_modified || a.data.date_created || '';
  const dateB = b.data.date_modified || b.data.date_created || '';
  return dateB.localeCompare(dateA);
});
---

<BaseLayout title="From the Rabbit Hole" description="Notes, observations, and half-formed ideas from deep dives into technology, investing, and building.">

  <section class="flex items-center justify-center px-6" style="min-height: 40vh;">
    <div class="text-center max-w-2xl">
      <h1 class="gradient-text mb-4">From the Rabbit Hole</h1>
      <p class="text-lg text-muted-foreground">
        {allNotes.length} {allNotes.length === 1 ? 'note' : 'notes'} — observations, half-formed ideas, and things worth writing down from deep dives into technology, investing, and building.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-16">
    <div class="grid gap-3">
      {allNotes.map(note => (
        <a href={`/notes/from-the-rabbit-hole/${note.id}`} class="block group">
          <article class="border border-border rounded-lg p-5 hover:border-primary/50 transition-colors bg-card">
            <h3 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors leading-tight mb-1">
              {note.data.title || note.id}
            </h3>

            {note.data.lede && (
              <p class="text-sm text-muted-foreground mb-3 line-clamp-2">{note.data.lede}</p>
            )}

            <div class="flex items-center gap-3 flex-wrap">
              {note.data.date_modified && (
                <span class="text-xs text-muted-foreground">{note.data.date_modified}</span>
              )}
              {note.data.tags && note.data.tags.length > 0 && (
                <div class="flex gap-1.5 flex-wrap">
                  {note.data.tags.slice(0, 5).map((tag: string) => (
                    <span class="text-xs px-1.5 py-0.5 rounded bg-muted text-muted-foreground">
                      {tag}
                    </span>
                  ))}
                  {note.data.tags.length > 5 && (
                    <span class="text-xs text-muted-foreground">+{note.data.tags.length - 5}</span>
                  )}
                </div>
              )}
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>
