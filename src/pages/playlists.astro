---
/**
 * /playlists — the curated YouTube playlists, one visible at a time.
 *
 * All three embeds render server-side and the toggle swaps which is shown.
 * That is deliberate rather than lazy: the player iframes carry
 * `loading="lazy"`, so a hidden panel costs markup but not a YouTube round
 * trip, and switching is instant with no fetch and no layout jump.
 *
 * The playlist set lives in src/config/playlists.ts, which the build-time
 * fetcher also reads — see the note there on why a registry exists alongside
 * the content-scraping discovery.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import YouTubePlaylistEmbed from '../components/markdown/YouTubePlaylistEmbed.astro';
import { PLAYLISTS } from '../config/playlists';
import { getPlaylist } from '../lib/youtube-playlist-cache';
import { getLiveCounts } from '../lib/youtube-playlist-live';

// Counts come from the cache, never from the registry, so the page cannot
// claim a number YouTube disagrees with. `getLiveCounts` then layers a
// runtime-refreshed number on top where it has one — that call never awaits
// the network, so a null result here just means "cache value is what we have."
const live = getLiveCounts(PLAYLISTS.map((p) => p.id));

const panels = PLAYLISTS.map((p, i) => {
  const data = getPlaylist(p.id);
  const fresh = live?.get(p.id);
  return {
    ...p,
    index: i,
    title: fresh?.title ?? data?.title ?? p.label,
    count: fresh?.itemCount ?? data?.itemCount ?? 0,
    unavailable: !data || data.unavailable === true,
  };
});

const total = panels.reduce((n, p) => n + p.count, 0);
---

<BaseLayout
  title="Playlists"
  description="Curated YouTube playlists — tools, engineering thinking, and the adjacent possible."
>
  <section class="px-6 pt-12 pb-8 md:pt-14 md:pb-10">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="gradient-text mb-3">Playlists</h1>
      <p class="text-lg text-muted-foreground">
        {panels.length} curated YouTube playlists — {total.toLocaleString()} videos
        collected over the years, on tools, engineering thinking, and the adjacent possible.
      </p>
      <p class="text-sm text-muted-foreground mt-3">
        Or browse <a href="/channels" class="underline underline-offset-4 hover:text-foreground transition-colors">the channels behind them</a>.
      </p>
    </div>
  </section>

  {/* max-w-4xl matches the essay reading column the scroller was tuned against.
      Its escape width is `min(340px, ((100vw - 100%) / 2) - 2rem)`, so a WIDER
      container yields a NARROWER scroller — 5xl would squeeze it to 96px at
      1280px, where 4xl gives 160px. Widening this page hurts the component. */}
  <section class="max-w-4xl mx-auto px-6 pb-16">
    {/* Hidden until the script marks it ready — inert buttons are worse than
        none, and the first panel is already the one server-rendered open. */}
    <div class="playlist-tabs mb-4 flex items-center justify-center gap-2 flex-wrap" id="playlist-tabs" role="tablist" aria-label="Playlists">
      {panels.map((p) => (
        <button
          type="button"
          class:list={['tab-pill', { active: p.index === 0 }]}
          role="tab"
          id={`playlist-tab-${p.index}`}
          aria-controls={`playlist-panel-${p.index}`}
          aria-selected={p.index === 0 ? 'true' : 'false'}
          data-playlist-tab={p.index}
        >
          {p.label}
          <span class="tab-count">{p.count.toLocaleString()}</span>
        </button>
      ))}
    </div>

    {panels.map((p) => (
      <div
        class="playlist-panel"
        id={`playlist-panel-${p.index}`}
        role="tabpanel"
        aria-labelledby={`playlist-tab-${p.index}`}
        data-playlist-panel={p.index}
        hidden={p.index !== 0}
      >
        {p.blurb && (
          <p class="text-sm text-muted-foreground text-center max-w-2xl mx-auto mb-8">{p.blurb}</p>
        )}
        {p.unavailable ? (
          <p class="text-sm text-muted-foreground text-center py-8">
            This playlist isn’t cached yet. Run <code>pnpm fetch-playlists</code> with
            <code>YOUTUBE_API_KEY</code> set.
          </p>
        ) : (
          <YouTubePlaylistEmbed id={p.id} index={p.index} />
        )}
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .playlist-tabs { display: none; }
  .playlist-tabs[data-ready] { display: flex; }

  .tab-pill {
    cursor: pointer;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    background: transparent;
    color: var(--muted-foreground);
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 0.4rem 0.95rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .tab-pill:hover { border-color: var(--primary); color: var(--foreground); }
  .tab-pill.active {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }
  .tab-count {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-pill { transition: none; }
  }
</style>

<script>
  function initPlaylistTabs() {
    const tabs = document.getElementById('playlist-tabs');
    if (!tabs || tabs.dataset.ready) return;

    const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>('[data-playlist-tab]'));
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('[data-playlist-panel]')
    );
    if (!buttons.length || !panels.length) return;

    tabs.dataset.ready = 'true';

    const show = (idx: string) => {
      buttons.forEach((b) => {
        const on = b.dataset.playlistTab === idx;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
      });
      panels.forEach((p) => {
        const on = p.dataset.playlistPanel === idx;
        p.hidden = !on;
      });
      // Reflected in the URL so a specific playlist is linkable and survives
      // a reload, without adding a history entry per click.
      const url = new URL(window.location.href);
      url.hash = `playlist-${idx}`;
      history.replaceState(null, '', url);
    };

    tabs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-playlist-tab]') as HTMLButtonElement | null;
      if (btn?.dataset.playlistTab) show(btn.dataset.playlistTab);
    });

    // Left/right arrows move between tabs — expected of role="tablist".
    tabs.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const i = buttons.findIndex((b) => b.getAttribute('aria-selected') === 'true');
      if (i < 0) return;
      const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
      buttons[next].focus();
      show(buttons[next].dataset.playlistTab!);
      e.preventDefault();
    });

    const fromHash = window.location.hash.match(/^#playlist-(\d+)$/);
    if (fromHash && buttons.some((b) => b.dataset.playlistTab === fromHash[1])) show(fromHash[1]);
  }

  initPlaylistTabs();
  document.addEventListener('astro:page-load', initPlaylistTabs);
</script>
