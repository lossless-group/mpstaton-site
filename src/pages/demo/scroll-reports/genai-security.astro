    .hero-container { min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; position: relative; color: #fff; overflow: hidden; }
    .hero-background { position: absolute; inset: 0; z-index: 1; background-color: var(--brand-bg); overflow: hidden; }
    .hero-background::before, .hero-background::after {
      content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(90deg,
        rgba(var(--current-grad-start-rgb), .8) 0%,  rgba(var(--current-grad-start-rgb), .2) 15%,
        rgba(var(--current-grad-end-rgb),   .2) 35%, rgba(var(--current-grad-end-rgb),   .8) 50%, rgba(var(--current-grad-end-rgb), .2) 65%,
        rgba(var(--current-grad-start-rgb), .2) 85%, rgba(var(--current-grad-start-rgb), .8) 100%);
      filter: blur(100px);
      animation: pan-background 30s linear infinite;
    }
    .hero-background::after { filter: blur(150px); opacity: .7; animation-duration: 45s; }
    .hero-content { position: relative; z-index: 10; padding: 20px; max-width: 760px; }
    .hero-eyebrow { font-size: .85rem; letter-spacing: .2em; text-transform: uppercase; color: var(--brand-muted); margin-bottom: 16px; }
    .hero-content h1 {
      font-size: clamp(2.6rem, 7.5vw, 4.4rem); font-weight: 700; letter-spacing: -.03em; margin: 0; line-height: 1.05;
      background: linear-gradient(135deg, #ffffff, #d1d1d1);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
      text-shadow: 0 4px 30px rgba(0,0,0,.5);
      animation: text-focus-in 1.2s cubic-bezier(.55,.085,.68,.53) both;
    }
    .hero-content h2 {
      font-size: clamp(1.05rem, 2.4vw, 1.25rem); font-weight: 400; color: var(--brand-muted);
      margin: 24px auto 0; max-width: 600px; line-height: var(--lh-normal);
      animation: text-focus-in 1.5s cubic-bezier(.55,.085,.68,.53) both;
    }
    .hero-attribution { margin-top: 40px; font-size: .85rem; color: rgba(255,255,255,.55); }
    .hero-attribution a { color: var(--brand-text-inverse); border-bottom: 1px dotted rgba(255,255,255,.4); }

    /* --- HERO KPIs --- */
    .hero-kpis {
      max-width: 1200px; margin: -100px auto 40px; padding: 0 24px;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
      position: relative; z-index: 20; perspective: 1000px;
    }
    @media (max-width: 1024px) { .hero-kpis { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px)  { .hero-kpis { grid-template-columns: 1fr; } }
    .kpi-card {
      position: relative; border: 1px solid rgba(255,255,255,.14); border-radius: 20px; overflow: hidden;
      background: rgba(9,12,18,.9);
      box-shadow: 0 8px 24px rgba(0,0,0,.35), inset 0 0 0 1px rgba(255,255,255,.02);
      padding: 32px; isolation: isolate;
    }
    .kpi-card::before { content: ''; position: absolute; inset: 0; z-index: 0; background: var(--kpi-gradient); opacity: .12; }
    .kpi-num { position: relative; z-index: 1; font-size: clamp(2.4rem, 8vw, 56px); font-weight: 900; line-height: 1; margin: 0 0 10px;
      background: var(--knum-gradient);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }
    .kpi-text { position: relative; z-index: 1; color: #dfe6f5; font-size: 17px; line-height: 1.45; margin: 0; }

    .kpi1 { --kpi-gradient: linear-gradient(135deg, rgba(139,92,246,.9), rgba(230,0,126,.85));
            --knum-gradient: linear-gradient(90deg, rgba(139,92,246,.9), rgba(230,0,126,.75)); }
    .kpi2 { --kpi-gradient: linear-gradient(135deg, rgba(0,174,239,.9), rgba(0,223,216,.85));
            --knum-gradient: linear-gradient(90deg, rgba(0,174,239,.9), rgba(0,223,216,.75)); }
    .kpi3 { --kpi-gradient: linear-gradient(135deg, rgba(139,92,246,.9), rgba(230,0,126,.85));
            --knum-gradient: linear-gradient(90deg, rgba(139,92,246,.9), rgba(230,0,126,.75)); }
    .kpi4 { --kpi-gradient: linear-gradient(135deg, rgba(230,0,126,.9), rgba(245,158,11,.85));
            --knum-gradient: linear-gradient(90deg, rgba(230,0,126,.9), rgba(245,158,11,.75)); }

    /* --- TYPOGRAPHY (inside report) --- */
    .content-section, .preface-content { max-width: 720px; margin: 0 auto; }
    .report-section h2 { font: 700 clamp(2rem, 5vw, 52.5px)/1.1 var(--font-sans); letter-spacing: -.01em; color: var(--brand-text-inverse); }
    .content-section h2, .preface-content h2 { text-align: left; margin-bottom: 32px; }
    .report-section h3 { font: 600 20px/1.2 var(--font-sans); color: var(--brand-text-inverse); margin-top: 48px; margin-bottom: 24px; }
    .report-section p { font-size: var(--fs-base); line-height: var(--lh-normal); color: var(--brand-muted); }
    .content-section p, .preface-content p { text-align: left; margin-bottom: 1.5em; }
    .highlight {
      background: linear-gradient(90deg, var(--current-grad-start), var(--current-grad-end));
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
      font-weight: 700;
    }

    /* --- AUTHOR BLOCK --- */
    .author-block { margin-top: 32px; display: flex; align-items: center; gap: 16px; color: var(--brand-text-inverse); font-size: var(--fs-base); line-height: 1.6; }
    .author-block strong { font-weight: 600; font-size: 1.05rem; }
    .author-title { color: var(--brand-muted); }
    .author-avatar {
      width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0;
      background: linear-gradient(135deg, #4f46e5, #8b5cf6);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; color: #fff; letter-spacing: .05em; font-size: .95rem;
      border: 2px solid rgba(255,255,255,.1);
    }

    /* --- QUOTE SECTION --- */
    #quote-section { padding: 48px 0; }
    .main-quote {
      position: relative; font: 500 italic clamp(1.4rem, 4.5vw, 2rem)/1.5 var(--font-serif);
      max-width: 800px; margin: 0 auto; padding-left: 50px; color: var(--brand-text-inverse);
    }
    .main-quote::before {
      content: '\201C'; font-size: 10rem; font-weight: 900; position: absolute; top: -2rem; left: -1rem; z-index: 0; opacity: .2;
      background: linear-gradient(135deg, var(--current-grad-start), var(--current-grad-end));
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }
    .main-quote cite { display: block; margin-top: 20px; font-size: 14px; color: var(--brand-muted); font-family: var(--font-sans); }

    .intro-quote {
      margin: 0 0 32px 0; padding: 24px;
      border-left: 3px solid var(--current-grad-start);
      background-color: rgba(var(--current-grad-start-rgb), .05);
      font-size: 1.4rem; font-style: italic; line-height: 1.6;
      max-width: 100%; text-align: left; border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      font-family: var(--font-serif); color: #f0f3f7;
    }
    .intro-quote cite { display: block; margin-top: 10px; font-size: 14px; color: var(--brand-muted); font-family: var(--font-sans); }

    /* --- STAT CARDS --- */
    .summary-cards-container { max-width: 1100px; margin: 64px auto; }
    .stat-card {
      position: relative; display: grid; grid-template-columns: 1fr 1fr;
      border: 1px solid var(--brand-border-dark);
      border-radius: 22px; overflow: hidden; margin: 22px 0 40px;
      background: radial-gradient(120% 160% at 0% 0%, rgba(255,255,255,.05), rgba(255,255,255,0) 60%);
      box-shadow: 0 10px 28px rgba(0,0,0,.35), inset 0 0 0 1px rgba(255,255,255,.02);
      isolation: isolate; transform-style: preserve-3d;
      transition: transform .25s ease, box-shadow .3s ease;
    }
    .stat-card::after { content: ''; position: absolute; inset: 0; z-index: 0; background: var(--panel-gradient); clip-path: inset(0 0 0 50%); }
    .stat-card::before { content: ''; position: absolute; inset: 0; z-index: 0; background: var(--panel-gradient); opacity: .12; }
    .stat-card .left, .stat-card .right { position: relative; z-index: 1; padding: 60px 48px; }
    .stat-card .left { display: grid; grid-template-columns: 56px 1fr; gap: 20px; align-items: start; }
    .stat-card .icon { width: 48px; height: 48px; margin-top: 4px; opacity: .95; }
    .stat-card .kicker { color: var(--brand-muted); font-size: 18px; font-weight: 600; margin: 0 0 8px; letter-spacing: .25px; }
    .stat-card .big {
      font-size: clamp(2.4rem, 9vw, 60px); font-weight: 800; line-height: 1; margin: 0 0 8px;
      background: var(--big-gradient);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }
    .stat-card .lead { font-size: 20px; line-height: 1.35; margin: 0; color: var(--brand-text-inverse); }
    .stat-card .right { display: flex; flex-direction: column; justify-content: center; }
    .stat-card .right h3 { font-size: 28px; font-weight: 800; margin: 0 0 16px; color: #fff; }
    .stat-card .right p { font-size: 18px; line-height: 1.45; margin: 0; color: #f1f4f9; }
    .stat-card .source { margin-top: 24px; font-size: 13px; color: var(--brand-muted); }

    .stat-card.acc1 { --panel-gradient: linear-gradient(135deg, rgba(139,92,246,.9), rgba(230,0,126,.85)); --big-gradient: linear-gradient(90deg, rgba(139,92,246,.85), rgba(230,0,126,.75)); }
    .stat-card.acc2 { --panel-gradient: linear-gradient(135deg, rgba(0,174,239,.9), rgba(0,223,216,.85));  --big-gradient: linear-gradient(90deg, rgba(0,174,239,.85), rgba(0,223,216,.75)); }
    .stat-card.acc3 { --panel-gradient: linear-gradient(135deg, rgba(230,0,126,.9), rgba(245,158,11,.85)); --big-gradient: linear-gradient(90deg, rgba(230,0,126,.85), rgba(245,158,11,.75)); }
    .stat-card.acc4 { --panel-gradient: linear-gradient(135deg, rgba(34,197,94,.9), rgba(111,0,255,.85));  --big-gradient: linear-gradient(90deg, rgba(34,197,94,.85), rgba(111,0,255,.75)); }
    .stat-card.acc5 { --panel-gradient: linear-gradient(135deg, rgba(245,158,11,.9), rgba(79,70,229,.85)); --big-gradient: linear-gradient(90deg, rgba(245,158,11,.85), rgba(79,70,229,.75)); }

    /* --- LISTS (custom-bullet & numbered) --- */
    .custom-bullet-list { padding: 0; margin-top: 40px; }
    .custom-bullet-list li {
      display: flex; align-items: flex-start; gap: 16px; margin-bottom: 12px; padding: 20px;
      background: var(--brand-surface); border: 1px solid var(--brand-border-dark);
      border-radius: var(--radius-md); font-size: 1.05rem; line-height: 1.6; color: var(--brand-text-inverse);
    }
    .custom-bullet-list li::before {
      content: '\2713'; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 50%;
      background: linear-gradient(90deg, var(--current-grad-start), var(--current-grad-end));
      color: var(--brand-bg); font-weight: 700; font-size: .9rem; margin-top: 2px;
    }
    .methodology-list li::before { content: 'i'; font-family: serif; font-weight: bold; font-style: italic; font-size: 1.1rem; }
    .numbered-list { padding: 0; margin-top: 40px; counter-reset: list-item; }
    .numbered-list li {
      display: flex; align-items: flex-start; gap: 16px; margin-bottom: 12px; padding: 20px;
      background: var(--brand-surface); border: 1px solid var(--brand-border-dark);
      border-radius: var(--radius-md); font-size: 1.05rem; line-height: 1.6; color: var(--brand-text-inverse);
    }
    .numbered-list li::before {
      content: counter(list-item); counter-increment: list-item;
      flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 50%;
      background: linear-gradient(90deg, var(--current-grad-start), var(--current-grad-end));
      color: var(--brand-bg); font-weight: 700; font-size: .9rem; margin-top: 2px;
    }

    /* --- DATA VISUALIZATIONS --- */
    .data-visualization-block { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; margin-top: 80px; }
    .data-visualization-block.reverse .data-list-container { order: 2; }
    .data-list-container h3, .text-content h3, .visual-container h3 {
      font-size: 1.5625rem; margin-bottom: 24px; text-align: left;
      background: linear-gradient(90deg, var(--current-grad-start), var(--current-grad-end));
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }
    .data-list { padding: 0; margin: 0; }
    .data-list li { display: flex; justify-content: space-between; align-items: baseline; padding: 12px 5px; border-bottom: 1px solid var(--brand-border-dark); }
    .data-list .label { display: flex; align-items: center; font-size: 15px; color: var(--brand-muted); }
    .data-list .label::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background-color: var(--color); margin-right: 12px; flex-shrink: 0; }
    .data-list .percentage { font-size: 1.1rem; font-weight: 600; color: var(--brand-text-inverse); }

    /* --- DONUT CHART (CSS conic-gradient) --- */
    .chart-visual { position: relative; max-width: 380px; margin: 0 auto; padding: 0; display: flex; align-items: center; justify-content: center; }
    .donut {
      --p1: 0; --p2: 0; --p3: 0; --p4: 0; --p5: 0;
      --t1: var(--p1);
      --t2: calc(var(--p1) + var(--p2));
      --t3: calc(var(--p1) + var(--p2) + var(--p3));
      --t4: calc(var(--p1) + var(--p2) + var(--p3) + var(--p4));
      width: 280px; height: 280px; border-radius: 50%;
      background: conic-gradient(
        var(--c1, #4f46e5) 0% calc(var(--t1) * 1%),
        var(--c2, #8b5cf6) calc(var(--t1) * 1%) calc(var(--t2) * 1%),
        var(--c3, #22c55e) calc(var(--t2) * 1%) calc(var(--t3) * 1%),
        var(--c4, #6b7280) calc(var(--t3) * 1%) calc(var(--t4) * 1%),
        var(--c5, #f59e0b) calc(var(--t4) * 1%) 100%
      );
      position: relative;
      box-shadow: 0 0 0 4px var(--brand-bg) inset, 0 12px 30px rgba(0,0,0,.35);
    }
    .donut::after {
      content: ''; position: absolute; inset: 22%; border-radius: 50%;
      background: var(--brand-bg);
      box-shadow: inset 0 0 30px rgba(0,0,0,.4);
    }
    @media (max-width: 900px) { .donut { width: 220px; height: 220px; } }

    /* --- HORIZONTAL BAR CHARTS (CSS) --- */
    .hbar-chart { padding: 0; margin: 8px 0 0 0; display: grid; gap: 18px; }
    .hbar-chart li { display: grid; grid-template-columns: 200px 1fr 60px; align-items: center; gap: 14px; }
    .hbar-label { font-size: 14px; color: var(--brand-text-inverse); }
    .hbar-track { height: 14px; background-color: rgba(255,255,255,.06); border-radius: 999px; overflow: hidden; position: relative; }
    .hbar-fill { height: 100%; width: var(--w, 0%); background: var(--c, var(--current-grad-start)); border-radius: 999px;
      box-shadow: 0 0 12px rgba(255,255,255,.06) inset;
      animation: bar-grow 1s cubic-bezier(.25,1,.5,1) both;
    }
    .hbar-value { font-size: 14px; font-weight: 600; color: var(--brand-text-inverse); text-align: right; }
    @media (max-width: 700px) {
      .hbar-chart li { grid-template-columns: 1fr; gap: 4px; }
      .hbar-value { text-align: left; }
    }

    /* --- TABLE / SPLIT LAYOUT --- */
    .split-layout { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 48px; align-items: start; margin: 64px 0; }
    .styled-table { width: 100%; border-collapse: collapse; }
    .styled-table th, .styled-table td { padding: 18px 15px; text-align: left; border-bottom: 1px solid var(--brand-border-dark); color: var(--brand-text-inverse); }
    .styled-table th { font-weight: 500; color: var(--brand-muted); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; }
    .styled-table .value { font-weight: 600; }
    .styled-table tbody tr:hover { background-color: rgba(255,255,255,.03); }

    /* --- VISUAL TITLES + FULL WIDTH --- */
    .full-width-visual { max-width: 100%; margin: 80px auto; }
    .visual-title {
      font-size: 1.5625rem; font-weight: 700; margin-bottom: 30px; text-align: center;
      background: linear-gradient(90deg, var(--current-grad-start), var(--current-grad-end));
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }
    .bar-chart-container .visual-title, .visual-table-container .visual-title { text-align: left; }

    /* --- QUADRANT --- */
    .quadrant-chart { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; perspective: 1000px; }
    .quadrant {
      padding: 40px; text-align: center; display: flex; flex-direction: column; justify-content: center; align-items: center;
      border-radius: 20px; transition: transform .4s cubic-bezier(.25,1,.5,1);
      background-color: rgba(var(--current-grad-start-rgb), .15);
      border: 1px solid var(--current-grad-start);
    }
    .quadrant:nth-child(2) { background-color: rgba(var(--current-grad-end-rgb), .15); border: 1px solid var(--current-grad-end); }
    .quadrant:nth-child(3) { background-color: rgba(var(--current-grad-start-rgb), .1); border: 1px solid var(--current-grad-start); opacity: .8; }
    .quadrant:nth-child(4) { background-color: rgba(var(--current-grad-end-rgb), .1); border: 1px solid var(--current-grad-end); opacity: .8; }
    .quadrant h3 { font-size: 1.5rem; margin: 0; color: var(--brand-text-inverse); }
    .quadrant .description { font-size: 1rem; color: var(--brand-muted); margin: 5px 0 20px; }
    .quadrant .percentage { font-size: 3rem; font-weight: 900; transition: transform .4s ease, text-shadow .4s ease; color: var(--brand-text-inverse); }
    @media (min-width: 992px) {
      .quadrant:hover { transform: scale(1.04) rotate3d(0,1,0,5deg); z-index: 10; box-shadow: 0 20px 50px rgba(0,0,0,.5); }
      .quadrant:hover .percentage { transform: scale(1.15); text-shadow: 0 0 15px rgba(255,255,255,.5); }
    }

    /* --- 2024 vs 2025 GRID --- */
    .visual-table-container { max-width: 100%; margin: 60px 0; }
    .visual-table-grid { display: grid; grid-template-columns: .8fr 2fr 2fr; gap: 20px; }
    .grid-header { font-weight: 700; color: var(--brand-muted); padding-bottom: 15px; border-bottom: 1px solid var(--brand-border-dark); }
    .grid-cell { padding: 25px 0; }
    .grid-cell.category { font-weight: 700; font-size: 1.2rem; color: var(--brand-text-inverse); }
    .data-point { margin-bottom: 30px; }
    .data-point:last-child { margin-bottom: 0; }
    .data-point .label { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: .9rem; color: var(--brand-muted); }
    .percentage-bar-bg { width: 100%; height: 8px; background-color: rgba(255,255,255,.05); border-radius: 4px; overflow: hidden; }
    .percentage-bar { height: 100%; border-radius: 4px; }
    .bar-2024 { background-color: #666; }
    .bar-2025 { background: linear-gradient(90deg, var(--current-grad-start), var(--current-grad-end)); }
    .table-description, .chart-description { max-width: 600px; margin: 20px auto 0; text-align: left; font-size: .9rem; color: var(--brand-muted); line-height: 1.6; }

    /* --- CTA HANDBOOK --- */
    .cta-handbook-container {
      max-width: 900px; width: 100%; margin: 80px auto 0;
      background-color: var(--brand-surface-2); color: var(--brand-text);
      border-radius: var(--radius-lg); position: relative; overflow: hidden;
      border: 1px solid var(--brand-border); box-shadow: var(--shadow-md);
    }
    .cta-handbook-container::before {
      content: ''; position: absolute; top: -50%; right: -50%; bottom: -50%; left: -50%;
      background-image: radial-gradient(circle at 20% 20%, var(--current-grad-start) 0%, transparent 35%),
                        radial-gradient(circle at 80% 80%, var(--current-grad-end) 0%, transparent 35%);
      filter: blur(120px); opacity: .7; z-index: 1; animation: cta-blob-spin 20s linear infinite;
    }
    .cta-handbook-content { position: relative; z-index: 3; padding: 56px 48px; }
    .cta-handbook-text h3 { font-size: 1.75rem; font-weight: 800; margin: 0 0 12px; color: var(--brand-text); }
    .cta-handbook-text p { color: #2a2f3d; font-size: 1rem; line-height: 1.6; margin: 0 0 24px; max-width: 540px; }
    .cta-button {
      display: inline-block; padding: 12px 22px; border-radius: 999px;
      background: linear-gradient(90deg, var(--current-grad-start), var(--current-grad-end));
      color: #fff; font-weight: 600; font-size: .95rem;
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .cta-button:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(0,0,0,.25); }

    /* --- ACTION STEPS / CONCLUSION --- */
    .action-steps-container { margin: 80px auto; max-width: 720px; }
    .action-steps-title { text-align: center; font-size: 2rem; font-weight: 700; margin-bottom: 40px; }
    .closing-thought { text-align: center; font-size: 1.5rem; font-style: italic; font-weight: 500; max-width: 600px; margin: 80px auto 0; line-height: 1.6; border-top: 1px solid var(--brand-border-dark); padding-top: 40px; color: var(--brand-text-inverse); }
    .credit-block { margin-top: 80px; }
    .credit { font-size: .85rem; color: var(--brand-muted); text-align: center; }
    .credit a { color: var(--brand-text-inverse); border-bottom: 1px dotted rgba(255,255,255,.4); }

    /* --- MOBILE NAV --- */
    .mobile-menu-button { display: none; background: none; border: none; cursor: pointer; z-index: 1010; padding: 10px; }
    .mobile-menu-button .icon-bar { display: block; width: 24px; height: 3px; background-color: var(--brand-text-inverse); border-radius: 3px; transition: all .3s ease; }
    .mobile-menu-button .icon-bar + .icon-bar { margin-top: 5px; }
    .mobile-nav {
      display: none; position: fixed; inset: 0; padding-top: 5rem; background-color: rgba(11,11,16,.95);
      backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); z-index: 1005;
      flex-direction: column; align-items: center; justify-content: center; gap: 30px;
      opacity: 0; transform: translateY(-20px); transition: opacity .3s ease, transform .3s ease; pointer-events: none;
    }
    body.mobile-nav-open .mobile-nav { display: flex; opacity: 1; transform: translateY(0); pointer-events: auto; }
    .mobile-nav a { color: var(--brand-text-inverse); font-size: 1.5rem; font-weight: 600; }
    body.mobile-nav-open .mobile-menu-button .icon-bar:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    body.mobile-nav-open .mobile-menu-button .icon-bar:nth-child(2) { opacity: 0; }
    body.mobile-nav-open .mobile-menu-button .icon-bar:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    @media (max-width: 900px) {
      .top-nav { display: none; }
      .mobile-menu-button { display: block; }
      .data-visualization-block, .data-visualization-block.reverse { grid-template-columns: 1fr; }
      .data-visualization-block.reverse .data-list-container { order: 0; }
      .stat-card { grid-template-columns: 1fr; }
      .stat-card::after { clip-path: inset(51.5% 0 0 0); }
      .stat-card .left, .stat-card .right { padding: 40px 24px; }
      .quadrant-chart { grid-template-columns: 1fr; }
      .visual-table-grid { display: block; }
      .visual-table-grid .grid-header { display: none; }
      .visual-table-grid .grid-cell { padding: 15px 0; border-bottom: 1px solid var(--brand-border-dark); }
      .visual-table-grid .grid-cell.category { padding-top: 30px; }
      .visual-table-grid .grid-cell:nth-of-type(3n-1) .data-point .label::before { content: '2024: '; font-weight: 600; color: var(--brand-muted); margin-right: 6px; }
      .visual-table-grid .grid-cell:nth-of-type(3n) .data-point .label::before   { content: '2025: '; font-weight: 600; color: var(--brand-muted); margin-right: 6px; }
      .cta-handbook-content { padding: 40px 28px; }
    }
    @media (max-width: 500px) {
      .report-main, .hero-kpis { padding: 0 16px; }
      .main-quote { padding-left: 10px; }
      .main-quote::before { left: -20px; top: -3rem; opacity: .1; }
      .stat-card .left { grid-template-columns: 1fr; gap: 10px; text-align: center; }
      .stat-card .icon { margin: 0 auto 10px; }
      .stat-card .right { text-align: center; }
    }

    /* --- ANIMATIONS --- */
    @keyframes fadeInDown   { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes text-focus-in { 0% { filter: blur(12px); opacity: 0; } 100% { filter: blur(0); opacity: 1; } }
    @keyframes pan-background { 0% { transform: translateX(-50%); } 100% { transform: translateX(50%); } }
    @keyframes bar-grow { 0% { width: 0; } 100% { width: var(--w, 0%); } }
    @keyframes cta-blob-spin { 0% { transform: rotate(0); } 100% { transform: rotate(360deg); } }
  </style>

  <script is:inline>
    // -------- Section theme + nav active state via IntersectionObserver --------
    (function () {
      const sections = Array.from(document.querySelectorAll('[data-section-id]'));
      const navDots = Array.from(document.querySelectorAll('.nav-dot'));
      const topNavLinks = Array.from(document.querySelectorAll('.top-nav-link'));
      const themeClasses = sections.map(s => s.getAttribute('data-theme')).filter(Boolean);

      const setActive = (sectionId) => {
        navDots.forEach(d => d.classList.toggle('active', d.dataset.section === sectionId));
        topNavLinks.forEach(l => l.classList.toggle('active', l.dataset.section === sectionId));
      };

      const setBodyTheme = (themeClass) => {
        if (!themeClass) return;
        themeClasses.forEach(c => { if (c !== themeClass) document.body.classList.remove(c); });
        document.body.classList.add(themeClass);
      };

      const observer = new IntersectionObserver((entries) => {
        // Pick the entry closest to the top of the viewport that's intersecting.
        const visible = entries.filter(e => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length === 0) return;
        const top = visible[0].target;
        const sectionId = top.getAttribute('data-section-id');
        const themeClass = top.getAttribute('data-theme');
        setActive(sectionId);
        setBodyTheme(themeClass);
      }, { rootMargin: '-30% 0px -50% 0px', threshold: 0 });

      sections.forEach(s => observer.observe(s));

      // Mark sections visible on enter for the subtle reveal.
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
      }, { threshold: 0.05 });
      document.querySelectorAll('.report-section').forEach(s => revealObserver.observe(s));
    })();

    // -------- Mobile menu toggle --------
    (function () {
      const btn = document.querySelector('.mobile-menu-button');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const open = document.body.classList.toggle('mobile-nav-open');
        btn.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll('.mobile-nav a').forEach(a =>
        a.addEventListener('click', () => {
          document.body.classList.remove('mobile-nav-open');
          btn.setAttribute('aria-expanded', 'false');
        })
      );
    })();

    // -------- Hero parallax (subtle) --------
    (function () {
      const heroContent = document.querySelector('.hero-content');
      if (!heroContent) return;
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          const opacity = Math.max(0, 1 - y / (window.innerHeight * 0.6));
          heroContent.style.transform = `translateY(${y * 0.4}px) scale(${1 - y * 0.0002})`;
          heroContent.style.opacity = String(opacity);
          ticking = false;
        });
      }, { passive: true });
    })();
  </script>
</body>
</html>
