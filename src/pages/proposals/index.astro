---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../../components/promote/BrandMark.astro';
import { getAllOpportunities, isProposalContent } from '../../lib/promote/opportunities';

export const prerender = false;

// Any opportunity carrying a `proposal` or `deck` material belongs here. This
// replaces a hardcoded slug list — adding a proposal is now one content
// directory, with no edit to this page.
// Only content under src/content/proposals/ — an investment deck living in
// src/content/promote/ is not a client proposal and does not belong here.
const proposals = getAllOpportunities()
  .filter((o) => isProposalContent(o.slug))
  .map((opportunity) => {
    // Prefer the proposal document; fall back to whatever is marked primary.
    return { opportunity, href: `/proposals/${opportunity.slug}` };
  })
  .sort((a, b) => a.opportunity.company_name.localeCompare(b.opportunity.company_name));

const meta = {
  title: 'Proposals · Michael P. Staton',
  description: 'Active proposals from The Lossless Group.',
  type: 'website' as const,
};
---
<BaseLayout title={meta.title} description={meta.description} meta={meta}>
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <section class="mx-auto max-w-5xl px-6 py-16">
    <header class="mb-10">
      <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Proposals</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-foreground">Active proposals</h1>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        Scopes of work and engagement proposals from The Lossless Group.
      </p>
    </header>

    {proposals.length === 0 && (
      <div class="rounded-lg border border-dashed border-border p-12 text-center">
        <p class="text-muted-foreground">No active proposals.</p>
      </div>
    )}

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {proposals.map(({ opportunity, href }) => (
        <a
          href={href}
          class="group flex flex-col rounded-xl border border-border bg-card/40 p-7 transition hover:border-foreground/30 hover:bg-card/70"
        >
          {opportunity.logo?.symbol || opportunity.logo?.wordmark ? (
            <span class="text-foreground">
              <BrandMark
                symbol={opportunity.logo?.symbol}
                wordmark={opportunity.logo?.wordmark}
                alt={opportunity.company_name}
                size={1.9}
              />
            </span>
          ) : (
            <p class="text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
              {opportunity.eyebrow}
            </p>
          )}
          <p class="mt-4 text-2xl font-semibold leading-snug text-foreground">
            {opportunity.company_name}
          </p>
          <p class="mt-3 flex-1 text-pretty text-sm leading-relaxed text-muted-foreground">
            {opportunity.short_description}
          </p>
          <span class="mt-6 inline-flex items-center gap-2 text-sm text-foreground">
            Open the proposal
            <span class="transition group-hover:translate-x-0.5">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
