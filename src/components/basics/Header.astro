---
import brand from '@brand';
import SocialsFaviconRow from './SocialsFaviconRow.astro';
---
<header class="px-6 py-4">
  <div class="gradient-line mb-0"></div>
  <nav class="max-w-6xl mx-auto flex items-center justify-between">
    <a href="/" class="hover:opacity-80 transition-opacity">
      <img src={brand.assets?.logoDark} alt={brand.name} class="h-8 w-auto" />
    </a>
    <div class="flex items-center gap-6 text-sm font-medium">
      <a href="/essays" class="text-muted-foreground hover:text-foreground transition-colors">Essays</a>
      <a href="/projects" class="text-muted-foreground hover:text-foreground transition-colors">Projects</a>
      <a href="/portfolio" class="text-muted-foreground hover:text-foreground transition-colors">Portfolio</a>
      <a href="/cv" class="text-muted-foreground hover:text-foreground transition-colors">CV</a>
      <a href="/playlists" class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-[#FF0000] transition-colors" aria-label="Playlists">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        <span>Playlists</span>
      </a>
      <SocialsFaviconRow />
    </div>
  </nav>
</header>
