---
/** The dashboard's legend. Always shown, so the summary reads on its own. */
---

<div class="pspd-legend" aria-label="Legend">
  <span><i data-status="stretch"></i>Stretch hit</span>
  <span><i data-status="base"></i>Base met (a win)</span>
  <span><i data-status="miss"></i>Below base</span>
  <span><i data-status="progress"></i>This week, in progress</span>
  <span><i data-status="unlogged"></i>Not logged yet (never a miss)</span>
  <span><i data-status="future"></i>Ahead</span>
</div>
