---
/**
 * LinkRollup — multi-URL container.
 *
 * Renders each URL as the matching format-per-format mapping (per spec §4.23.6):
 *   column → row · gallery → card · carousel → card · thumb-row → thumb
 *
 * Reads the directive's resolved spec (`linkPreviewSpec`) plus the per-URL
 * data the og-fetcher attached to each link's `node.data.linkPreview`.
 *
 * For now (no OG yet), each item degrades to URL + host via LinkPreviewCard's
 * own fallback path.
 */

import LinkPreviewCard from './LinkPreviewCard.astro';

interface PreviewItem {
  url: string;
  /** Per-URL OG data, when fetched. */
  data?: Record<string, unknown>;
}

interface Props {
  urls: string[];
  format?: 'column' | 'gallery' | 'carousel' | 'thumb-row--horizontal-scroll';
  type?: 'article' | 'video' | 'audio' | 'code' | 'tweet' | 'unknown';
  columns?: number;
  /** Optional per-URL data lookup, keyed by URL. */
  itemData?: Record<string, PreviewItem['data']>;
}

const {
  urls,
  format = 'gallery',
  type = 'article',
  columns = 3,
  itemData = {},
} = Astro.props as Props;

const childFormat: 'row' | 'card' | 'thumb' = (() => {
  if (format === 'column') return 'row';
  if (format === 'thumb-row--horizontal-scroll') return 'thumb';
  return 'card';
})();
---

{format === 'carousel' ? (
  <div class="lfm-rollup-carousel" data-lfm-carousel>
    <button class="lfm-rollup-nav lfm-rollup-nav--prev" type="button" aria-label="Scroll left" data-lfm-carousel-prev hidden>‹</button>
    <div class="lfm-link-rollup lfm-link-rollup--carousel" data-lfm-carousel-track>
      {urls.map((url) => (
        <LinkPreviewCard url={url} format={childFormat} type={type} data={itemData[url] as any} />
      ))}
    </div>
    <button class="lfm-rollup-nav lfm-rollup-nav--next" type="button" aria-label="Scroll right" data-lfm-carousel-next hidden>›</button>
  </div>
) : (
  <div class={`lfm-link-rollup lfm-link-rollup--${format}`} style={`--lfm-rollup-columns: ${columns}`}>
    {urls.map((url) => (
      <LinkPreviewCard url={url} format={childFormat} type={type} data={itemData[url] as any} />
    ))}
  </div>
)}

<script>
  // Progressive enhancement: the carousel is a scroll-snap flex row and works
  // with no JS at all. This only adds the arrows, and only when the track
  // actually overflows — so a two-card rollup shows no chrome.
  for (const root of document.querySelectorAll<HTMLElement>('[data-lfm-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-lfm-carousel-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-lfm-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-lfm-carousel-next]');
    if (!track || !prev || !next) continue;

    const sync = () => {
      const overflowing = track.scrollWidth > track.clientWidth + 4;
      const atStart = track.scrollLeft <= 4;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      prev.hidden = !overflowing || atStart;
      next.hidden = !overflowing || atEnd;
    };
    const page = (dir: number) =>
      track.scrollBy({ left: dir * Math.max(240, track.clientWidth * 0.8), behavior: 'smooth' });

    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));
    track.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(track);
    sync();
  }
</script>

<style>
  .lfm-link-rollup {
    margin: 1.5rem 0;
  }
  .lfm-link-rollup--column {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .lfm-link-rollup--gallery {
    display: grid;
    grid-template-columns: repeat(var(--lfm-rollup-columns, 3), minmax(0, 1fr));
    gap: 1rem;
  }
  .lfm-link-rollup--gallery :global(.lfm-link-preview--card) {
    grid-template-columns: 1fr;
    margin: 0;
  }
  .lfm-link-rollup--gallery :global(.lfm-card-media) {
    aspect-ratio: 16/9;
    width: 100%;
  }
  .lfm-link-rollup--gallery :global(.lfm-card-media img) {
    aspect-ratio: 16/9;
  }
  .lfm-rollup-carousel {
    position: relative;
    margin: 1.5rem 0;
  }
  .lfm-link-rollup--carousel {
    display: flex;
    overflow-x: auto;
    gap: 1rem;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
    margin: 0;
    /* Stay inside the parent's width so an ancestor scroller stays still. */
    max-width: 100%;
    min-width: 0;
    scrollbar-width: thin;
  }
  .lfm-rollup-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--border, rgba(127,127,127,0.35));
    background: var(--background, #111);
    color: var(--foreground, #eee);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.9;
  }
  .lfm-rollup-nav:hover { opacity: 1; }
  .lfm-rollup-nav--prev { left: -0.75rem; }
  .lfm-rollup-nav--next { right: -0.75rem; }
  .lfm-rollup-nav[hidden] { display: none; }

  /* Carousel cards stack: image window on top at the og:image aspect ratio,
   * then host + title, then description. Without these the card falls back to
   * its default two-column grid (media left, text right), which at a 320px
   * track width squeezes the copy into a ~120px column. */
  .lfm-link-rollup--carousel :global(.lfm-link-preview--card) {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
    gap: 0;
    margin: 0;
    align-content: start;
  }
  .lfm-link-rollup--carousel :global(.lfm-card-media) {
    width: 100%;
    /* 1200x630 — the og:image standard every one of these sites targets. */
    aspect-ratio: 1200 / 630;
    overflow: hidden;
  }
  .lfm-link-rollup--carousel :global(.lfm-card-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lfm-link-rollup--carousel :global(.lfm-card-body) {
    padding: 0.875rem 1rem 1.125rem;
    min-width: 0;
  }
  .lfm-link-rollup--carousel :global(.lfm-card-title) {
    font-size: 0.9375rem;
    line-height: 1.3;
    margin-top: 0.375rem;
  }
  .lfm-link-rollup--carousel :global(.lfm-card-description) {
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .lfm-link-rollup--carousel :global(.lfm-link-preview) {
    flex: 0 0 320px;
    scroll-snap-align: start;
  }
  .lfm-link-rollup--thumb-row--horizontal-scroll {
    display: flex;
    overflow-x: auto;
    gap: 0.5rem;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }
  .lfm-link-rollup--thumb-row--horizontal-scroll :global(.lfm-link-preview--thumb) {
    flex: 0 0 180px;
    scroll-snap-align: start;
  }

  @media (max-width: 720px) {
    .lfm-link-rollup--gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
