---
/**
 * YouTubePlaylistPlayer — the in-column "card" sibling of the playlist
 * component family. Renders the header strip + 16:9 iframe player.
 *
 * Spec: context-v/specs/Versatile-Component-Library-for-Video-Players.md §4.1.3
 *
 * This component flows in the article column at the column's natural width.
 * Its sibling — YouTubePlaylistScroller — escape-positions itself in the
 * right margin track on wide viewports, but that sibling is rendered by
 * the orchestrator (YouTubePlaylistEmbed), not by this component.
 *
 * The two siblings share an `iframeId` so the scroller's Svelte island can
 * find this iframe via document.getElementById() and postMessage commands
 * to it through the YouTube IFrame Player API.
 */

interface Props {
  iframeId: string;
  playlistId: string;
  title?: string;
  channelTitle?: string;
  totalCount: number;
}

const { iframeId, playlistId, title, channelTitle, totalCount } = Astro.props;

const embedSrc = `https://www.youtube-nocookie.com/embed/videoseries?list=${playlistId}&enablejsapi=1&modestbranding=1&rel=0`;
---

<aside class="yt-pl-player" aria-label={title ?? 'YouTube playlist'}>
  <header class="yt-pl-player__header">
    <div class="yt-pl-player__title-block">
      <p class="yt-pl-player__eyebrow">YouTube playlist</p>
      <h3 class="yt-pl-player__title">{title ?? 'YouTube playlist'}</h3>
      <p class="yt-pl-player__meta">
        {channelTitle && <span>{channelTitle}</span>}
        {channelTitle && <span aria-hidden="true">·</span>}
        <span>{totalCount} {totalCount === 1 ? 'video' : 'videos'}</span>
      </p>
    </div>
    <a
      class="yt-pl-player__open-on-yt"
      href={`https://www.youtube.com/playlist?list=${playlistId}`}
      target="_blank"
      rel="noopener"
      title="Open playlist on YouTube"
    >
      Open on YouTube ↗
    </a>
  </header>
  <div class="yt-pl-player__frame">
    <iframe
      id={iframeId}
      src={embedSrc}
      title={title ?? 'YouTube playlist player'}
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
      loading="lazy"
    />
  </div>
</aside>

<style>
  .yt-pl-player {
    border: 1px solid var(--border, rgba(145, 56, 224, 0.18));
    border-radius: 14px;
    overflow: hidden;
    background: var(--card, rgba(255, 255, 255, 0.03));
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.35);
  }
  .yt-pl-player__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border, rgba(145, 56, 224, 0.12));
    background: linear-gradient(
      to right,
      rgba(4, 229, 229, 0.04),
      transparent 60%
    );
  }
  .yt-pl-player__eyebrow {
    margin: 0 0 0.1rem 0;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-aqua, #04E5E5);
  }
  .yt-pl-player__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--foreground, #e2e8f0);
  }
  .yt-pl-player__meta {
    margin: 0.25rem 0 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--muted-foreground, #94a3b8);
  }
  .yt-pl-player__open-on-yt {
    flex-shrink: 0;
    font-size: 0.78rem;
    color: var(--brand-aqua, #04E5E5);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border, rgba(145, 56, 224, 0.18));
    border-radius: 6px;
    transition: background-color 0.12s;
    white-space: nowrap;
  }
  .yt-pl-player__open-on-yt:hover,
  .yt-pl-player__open-on-yt:focus-visible {
    background: rgba(4, 229, 229, 0.08);
    text-decoration: underline;
  }
  .yt-pl-player__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .yt-pl-player__frame iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>
