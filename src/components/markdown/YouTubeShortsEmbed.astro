---
interface Props {
  url: string;
  caption?: string;
}

const { url, caption } = Astro.props;

const extractYouTubeVideoId = (url: string): string | null => {
  const youtuBeMatch = url.match(/youtu\.be\/([a-zA-Z0-9_-]+)/);
  if (youtuBeMatch) return youtuBeMatch[1];
  const watchMatch = url.match(/youtube\.com\/watch\?.*v=([a-zA-Z0-9_-]+)/);
  if (watchMatch) return watchMatch[1];
  const shortsMatch = url.match(/youtube\.com\/shorts\/([a-zA-Z0-9_-]+)/);
  if (shortsMatch) return shortsMatch[1];
  return null;
};

const videoId = extractYouTubeVideoId(url);
if (!videoId) throw new Error(`Invalid YouTube URL: ${url}`);

let embedUrl = `https://www.youtube.com/embed/${videoId}`;
const siMatch = url.match(/[?&]si=([^&]+)/);
if (siMatch) embedUrl += `?si=${siMatch[1]}`;
---

<div class="youtube-shorts-container">
  <div class="youtube-shorts-wrapper">
    <iframe
      src={embedUrl}
      title="YouTube Shorts video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
      loading="lazy"
    />
  </div>
  {caption && (
    <div class="youtube-shorts-caption">
      <div class="caption-content">{caption}</div>
      <button
        class="copy-url-btn"
        onclick={`navigator.clipboard.writeText('${url}').then(() => {
          const btn = event.target.closest('.copy-url-btn');
          btn.classList.add('copied');
          setTimeout(() => { btn.classList.remove('copied'); }, 2000);
        }).catch(err => console.error('Failed to copy: ', err))`}
        title="Copy video URL to clipboard"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16 3H4V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 7H20V20H8V7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  )}
</div>

<style>
  .youtube-shorts-container {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .youtube-shorts-wrapper {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 9/16;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    background: #000;
    position: relative;
    border: 1px solid var(--brand-aqua, #04E5E5);
  }
  .youtube-shorts-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .youtube-shorts-caption {
    width: 100%;
    max-width: 320px;
    padding: 0.75rem 1rem;
    background: var(--card, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--border, rgba(145, 56, 224, 0.15));
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--foreground, #e2e8f0);
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .caption-content { flex: 1; min-width: 0; }
  .copy-url-btn {
    background: transparent;
    border: 1px solid var(--brand-aqua, #04E5E5);
    border-radius: 6px;
    padding: 0.5rem;
    cursor: pointer;
    color: var(--foreground, #e2e8f0);
    transition: opacity 0.2s, background-color 0.2s;
    flex-shrink: 0;
    min-width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
  }
  .copy-url-btn:hover,
  .copy-url-btn:focus-visible {
    opacity: 1;
    background-color: rgba(4, 229, 229, 0.1);
    outline: 2px solid var(--brand-aqua, #04E5E5);
    outline-offset: 2px;
  }
  .copy-url-btn.copied {
    background: rgba(34, 197, 94, 0.2);
    border-color: rgba(34, 197, 94, 0.4);
    color: #4ade80;
  }
  .copy-url-btn svg { width: 16px; height: 16px; }

  @media (max-width: 768px) {
    .youtube-shorts-wrapper, .youtube-shorts-caption { max-width: 280px; }
  }
  @media (max-width: 480px) {
    .youtube-shorts-wrapper, .youtube-shorts-caption { max-width: 240px; }
  }
</style>
