---
/**
 * YouTubePlaylistEmbed — full playlist UX per:
 * context-v/specs/Versatile-Component-Library-for-Video-Players.md §4.1.3
 *
 * Astro shell + Svelte island architecture:
 * - Astro server-renders the wrapper, header strip, and iframe
 * - PlaylistSidebar.svelte renders the sidebar list and handles click-to-play
 *   via the YouTube IFrame Player API (postMessage)
 * - MobileFeaturePlaceholder wraps the sidebar so it becomes a full-screen
 *   panel on mobile (≤768px)
 *
 * Data is sourced from src/data/youtube-playlist-cache.json, populated by
 * scripts/fetch-youtube-playlists.ts at build time.
 */

import PlaylistSidebar from './PlaylistSidebar.svelte';
import MobileFeaturePlaceholder from './MobileFeaturePlaceholder.astro';
import { getPlaylist, formatDuration } from '../../lib/youtube-playlist-cache';

interface Props {
  url?: string;
  id?: string;
  index?: number;
  caption?: string;
}

const { url, id: idProp, index = 0, caption } = Astro.props;

function extractPlaylistId(u: string): string | null {
  try {
    return new URL(u).searchParams.get('list');
  } catch {
    return null;
  }
}

const playlistId = idProp ?? (url ? extractPlaylistId(url) : null);
if (!playlistId) {
  throw new Error(
    `YouTubePlaylistEmbed requires id or url; got id=${idProp ?? '(none)'} url=${url ?? '(none)'}`
  );
}

const data = getPlaylist(playlistId);
const ITEM_CAP = 50;
const allItems = data?.items ?? [];
// Default sort: most-recently-added on top. Falls back to playlist position
// for items without addedAt (older cache entries, edge cases).
const sortedItems = [...allItems].sort((a, b) => {
  if (a.addedAt && b.addedAt) return b.addedAt.localeCompare(a.addedAt);
  if (a.addedAt) return -1;
  if (b.addedAt) return 1;
  return a.position - b.position;
});
const visibleItems = sortedItems.slice(0, ITEM_CAP);
const overflow = sortedItems.length > ITEM_CAP;
const totalCount = data?.itemCount ?? allItems.length;

const iframeId = `yt-pl-${playlistId}`;
const embedSrc = `https://www.youtube-nocookie.com/embed/videoseries?list=${playlistId}&enablejsapi=1&modestbranding=1&rel=0`;

const isUnavailable = !data || data.unavailable || allItems.length === 0;
---

<aside class="yt-playlist" aria-label={data?.title ?? 'YouTube playlist'}>
  <header class="yt-playlist__header">
    <div class="yt-playlist__title-block">
      <p class="yt-playlist__eyebrow">YouTube playlist</p>
      <h3 class="yt-playlist__title">{data?.title ?? 'YouTube playlist'}</h3>
      {data && (
        <p class="yt-playlist__meta">
          {data.channelTitle && <span>{data.channelTitle}</span>}
          {data.channelTitle && <span aria-hidden="true">·</span>}
          <span>{totalCount} {totalCount === 1 ? 'video' : 'videos'}</span>
        </p>
      )}
    </div>
    <a
      class="yt-playlist__open-on-yt"
      href={`https://www.youtube.com/playlist?list=${playlistId}`}
      target="_blank"
      rel="noopener"
      title="Open playlist on YouTube"
    >
      Open on YouTube ↗
    </a>
  </header>

  <div class="yt-playlist__layout">
    <div class="yt-playlist__player">
      <iframe
        id={iframeId}
        src={embedSrc}
        title={data?.title ?? 'YouTube playlist player'}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
        loading="lazy"
      />
    </div>

    <div class="yt-playlist__sidebar">
      {isUnavailable ? (
        <div class="yt-playlist__unavailable">
          <p>Playlist details unavailable.</p>
          <p class="yt-playlist__unavailable-detail">
            The playlist will still play in the embedded player above.
          </p>
        </div>
      ) : (
        <MobileFeaturePlaceholder
          label={`Browse ${totalCount} ${totalCount === 1 ? 'video' : 'videos'}`}
          panelTitle={data?.title}
        >
          <Fragment slot="placeholder">
            <div class="yt-playlist__placeholder">
              <p class="yt-playlist__placeholder-title">{data?.title}</p>
              <div class="yt-playlist__placeholder-thumbs">
                {visibleItems.slice(0, 4).map((item) => (
                  <img src={item.thumbnail} alt="" loading="lazy" width="80" height="45" />
                ))}
              </div>
              <p class="yt-playlist__placeholder-count">
                {data?.channelTitle && `${data.channelTitle} · `}{totalCount} videos
              </p>
            </div>
          </Fragment>

          <PlaylistSidebar
            client:visible
            items={visibleItems}
            playlistId={playlistId}
            iframeId={iframeId}
            initialIndex={index}
            totalCount={totalCount}
            overflow={overflow}
          />
        </MobileFeaturePlaceholder>
      )}
    </div>
  </div>

  {caption && <p class="yt-playlist__caption">{caption}</p>}
</aside>

<style>
  .yt-playlist {
    /* Tighter than before — was 1.5rem, the article had too much breathing room */
    margin-block: 0.5rem;
    border: 1px solid var(--border, rgba(145, 56, 224, 0.18));
    border-radius: 14px;
    background: var(--card, rgba(255, 255, 255, 0.03));
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.35);
    /* `overflow: hidden` removed so the right-escape sidebar can extend
       past the component's box on wide viewports. The sub-areas (player,
       header) keep their own border-radius via clip-path or border-radius
       on themselves where needed. */
  }

  .yt-playlist__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border, rgba(145, 56, 224, 0.12));
    background: linear-gradient(
      to right,
      rgba(4, 229, 229, 0.04),
      transparent 60%
    );
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
  }
  .yt-playlist__eyebrow {
    margin: 0 0 0.1rem 0;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-aqua, #04E5E5);
  }
  .yt-playlist__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--foreground, #e2e8f0);
  }
  .yt-playlist__meta {
    margin: 0.25rem 0 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--muted-foreground, #94a3b8);
  }
  .yt-playlist__open-on-yt {
    flex-shrink: 0;
    font-size: 0.78rem;
    color: var(--brand-aqua, #04E5E5);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border, rgba(145, 56, 224, 0.18));
    border-radius: 6px;
    transition: background-color 0.12s;
    white-space: nowrap;
  }
  .yt-playlist__open-on-yt:hover,
  .yt-playlist__open-on-yt:focus-visible {
    background: rgba(4, 229, 229, 0.08);
    text-decoration: underline;
  }

  /* Default layout (≤1279px): single column — header, player, then sidebar
     stacked. Sidebar height capped to ~3 items so it doesn't dominate. */
  .yt-playlist__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .yt-playlist__player {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    overflow: hidden;
  }
  .yt-playlist__player iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .yt-playlist__sidebar {
    min-height: 0;
    border-top: 1px solid var(--border, rgba(145, 56, 224, 0.12));
    /* Default cap: ~3 items + tiny scroll affordance */
    max-height: 232px;
    overflow: hidden;
  }

  /* Wide-desktop right-escape: the sidebar pops out into the article's right
     margin track. Player stays at the article column width; header sits above
     the player only. This is the first concrete consumer of the `aside-escape`
     pattern (LFM video spec §4.1.3 + cross-cutting per §5.5).
     `(100vw - 100%) / 2` is the right margin space outside this component's
     parent column; pulling it negative lets the component span past the column
     edge into that space, capped at 2rem from the viewport's right edge. */
  @media (min-width: 1280px) {
    .yt-playlist {
      margin-right: calc(((100vw - 100%) / -2) + 2rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) 1.5rem minmax(280px, 340px);
      grid-template-rows: auto auto;
      grid-template-areas:
        "header header header"
        "player gap   sidebar";
    }
    .yt-playlist__header {
      grid-area: header;
      border-top-right-radius: 14px;
    }
    .yt-playlist__layout { display: contents; }
    .yt-playlist__player {
      grid-area: player;
      border-bottom-right-radius: 0;
      border-bottom-left-radius: 14px;
    }
    .yt-playlist__sidebar {
      grid-area: sidebar;
      max-height: none;       /* matches player height via grid row stretch */
      align-self: stretch;
      border-top: none;
      border-left: 1px solid var(--border, rgba(145, 56, 224, 0.12));
      border-radius: 0 14px 14px 0;
      overflow: hidden;
    }
  }

  .yt-playlist__unavailable {
    padding: 1rem;
    color: var(--muted-foreground, #94a3b8);
    font-size: 0.9rem;
    text-align: center;
  }
  .yt-playlist__unavailable-detail {
    font-size: 0.78rem;
    margin-top: 0.4rem;
  }

  .yt-playlist__caption {
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--border, rgba(145, 56, 224, 0.12));
    font-size: 0.85rem;
    color: var(--muted-foreground, #94a3b8);
    margin: 0;
  }

  /* Mobile placeholder content */
  .yt-playlist__placeholder-title {
    margin: 0 0 0.6rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--foreground, #e2e8f0);
  }
  .yt-playlist__placeholder-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }
  .yt-playlist__placeholder-thumbs img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: #000;
  }
  .yt-playlist__placeholder-count {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted-foreground, #94a3b8);
  }
</style>
