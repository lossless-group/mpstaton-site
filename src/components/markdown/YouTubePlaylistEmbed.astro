---
/**
 * YouTubePlaylistEmbed — orchestrator. Reads the build-time playlist cache,
 * sorts items by addedAt descending, and renders two visually-separate
 * sibling components inside a position:relative wrapper:
 *
 *   1. <YouTubePlaylistPlayer />   — the in-column card with header + iframe
 *   2. <YouTubePlaylistScroller /> — escape-positioned (≥1280px) or stacked
 *                                    (768–1279px) or panel (≤768px) list
 *
 * The wrapper is `position: relative` so the scroller's `position: absolute`
 * at ≥1280px anchors to the wrapper's box (the article column width).
 *
 * The two siblings communicate only via the shared `iframeId` — the
 * scroller's Svelte island finds the iframe by ID and uses postMessage to
 * send playVideoAt(N) commands through the YouTube IFrame Player API.
 *
 * Spec: context-v/specs/Versatile-Component-Library-for-Video-Players.md §4.1.3
 */

import YouTubePlaylistPlayer from './YouTubePlaylistPlayer.astro';
import YouTubePlaylistScroller from './YouTubePlaylistScroller.astro';
import { getPlaylist } from '../../lib/youtube-playlist-cache';

interface Props {
  url?: string;
  id?: string;
  index?: number;
  caption?: string;
}

const { url, id: idProp, index = 0, caption } = Astro.props;

function extractPlaylistId(u: string): string | null {
  try {
    return new URL(u).searchParams.get('list');
  } catch {
    return null;
  }
}

const playlistId = idProp ?? (url ? extractPlaylistId(url) : null);
if (!playlistId) {
  throw new Error(
    `YouTubePlaylistEmbed requires id or url; got id=${idProp ?? '(none)'} url=${url ?? '(none)'}`
  );
}

const data = getPlaylist(playlistId);
const ITEM_CAP = 50;
const allItems = data?.items ?? [];

// Default sort: most-recently-added on top. Falls back to playlist position
// for items without addedAt (older cache entries, edge cases). The click
// handler in PlaylistSidebar still uses each item's actual `position` for
// the iframe `playVideoAt(N)` call, so the visual order is independent of
// the playback addressing.
const sortedItems = [...allItems].sort((a, b) => {
  if (a.addedAt && b.addedAt) return b.addedAt.localeCompare(a.addedAt);
  if (a.addedAt) return -1;
  if (b.addedAt) return 1;
  return a.position - b.position;
});
const visibleItems = sortedItems.slice(0, ITEM_CAP);
const overflow = sortedItems.length > ITEM_CAP;
const totalCount = data?.itemCount ?? allItems.length;

const iframeId = `yt-pl-${playlistId}`;
const isUnavailable = !data || data.unavailable || allItems.length === 0;
---

<div class="yt-playlist-block">
  <YouTubePlaylistPlayer
    iframeId={iframeId}
    playlistId={playlistId}
    title={data?.title}
    channelTitle={data?.channelTitle}
    totalCount={totalCount}
  />
  <YouTubePlaylistScroller
    iframeId={iframeId}
    playlistId={playlistId}
    items={visibleItems}
    totalCount={totalCount}
    overflow={overflow}
    initialIndex={index}
    title={data?.title}
    channelTitle={data?.channelTitle}
    isUnavailable={isUnavailable}
  />
</div>

{caption && <p class="yt-playlist-caption">{caption}</p>}

<style>
  /* The orchestrator owns only the relationship between the two siblings:
     a `position: relative` wrapper that anchors the scroller's absolute
     positioning at ≥1280px. All chrome / layout / responsive behaviour
     lives in the child components. */
  .yt-playlist-block {
    position: relative;
    margin-block: 0.75rem;
  }

  .yt-playlist-caption {
    margin: 0.4rem 0 0 0;
    font-size: 0.85rem;
    color: var(--muted-foreground, #94a3b8);
  }
</style>
