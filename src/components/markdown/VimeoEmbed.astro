---
interface Props {
  url: string;
  caption?: string;
}

const { url, caption } = Astro.props;

interface VimeoParts {
  id: string;
  hash?: string;
}

const extractVimeoVideoParts = (raw: string): VimeoParts | null => {
  // canonical: vimeo.com/{id}, vimeo.com/{id}/{hash}, vimeo.com/channels/x/{id}, vimeo.com/album/x/video/{id}
  const canonical = raw.match(/vimeo\.com\/(?:[^/?#]+\/)*?(\d+)(?:\/([A-Za-z0-9]+))?/);
  if (canonical) return { id: canonical[1], hash: canonical[2] };
  // already-embed: player.vimeo.com/video/{id}, player.vimeo.com/video/{id}/{hash}
  const player = raw.match(/player\.vimeo\.com\/video\/(\d+)(?:\/([A-Za-z0-9]+))?/);
  if (player) return { id: player[1], hash: player[2] };
  return null;
};

const parts = extractVimeoVideoParts(url);
if (!parts) throw new Error(`Invalid Vimeo URL: ${url}`);

const params = new URLSearchParams();
if (parts.hash) params.set('h', parts.hash);
const query = params.toString();
const embedUrl = `https://player.vimeo.com/video/${parts.id}${query ? `?${query}` : ''}`;
---

<div class="vimeo-embed-wrapper">
  <iframe
    style="aspect-ratio:16/9;width:100%;height:auto;max-width:100%"
    src={embedUrl}
    title="Vimeo video player"
    frameborder="0"
    allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
    loading="lazy"
  />
  {caption && (
    <div class="vimeo-caption">
      <div class="caption-content">{caption}</div>
      <button
        class="copy-url-btn"
        onclick={`navigator.clipboard.writeText('${url}').then(() => {
          const btn = event.target.closest('.copy-url-btn');
          btn.classList.add('copied');
          setTimeout(() => { btn.classList.remove('copied'); }, 2000);
        }).catch(err => console.error('Failed to copy: ', err))`}
        title="Copy video URL to clipboard"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16 3H4V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 7H20V20H8V7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  )}
</div>

<style>
  .vimeo-embed-wrapper {
    margin: 1.5rem 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.25), 0 2px 4px -1px rgba(0, 0, 0, 0.15);
    border: 1px solid var(--border, rgba(145, 56, 224, 0.15));
  }
  .vimeo-embed-wrapper iframe {
    display: block;
    border: none;
  }
  .vimeo-caption {
    padding: 0.75rem 1rem;
    background: var(--card, rgba(255, 255, 255, 0.05));
    border-top: 1px solid var(--border, rgba(145, 56, 224, 0.15));
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--foreground, #e2e8f0);
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .caption-content { flex: 1; min-width: 0; }
  .copy-url-btn {
    background: transparent;
    border: 1px solid var(--brand-aqua, #04E5E5);
    border-radius: 6px;
    padding: 0.5rem;
    cursor: pointer;
    color: var(--foreground, #e2e8f0);
    transition: opacity 0.2s, background-color 0.2s;
    flex-shrink: 0;
    min-width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
  }
  .copy-url-btn:hover,
  .copy-url-btn:focus-visible {
    opacity: 1;
    background-color: rgba(4, 229, 229, 0.1);
    outline: 2px solid var(--brand-aqua, #04E5E5);
    outline-offset: 2px;
  }
  .copy-url-btn.copied {
    background: rgba(34, 197, 94, 0.2);
    border-color: rgba(34, 197, 94, 0.4);
    color: #4ade80;
  }
  .copy-url-btn svg { width: 16px; height: 16px; }
</style>
