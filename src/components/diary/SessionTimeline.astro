---
import { toDisplayTime } from '../../lib/diary/schedule';

interface Speaker { name: string; org?: string }
interface Track {
  title: string; room?: string; kind?: string; desc?: string;
  speakers?: Speaker[]; more?: string;
}
interface Session {
  from?: string; to?: string; title?: string;
  state?: 'locked' | 'open';
  room?: string; kind?: string; desc?: string; note?: string;
  speakers?: Speaker[]; tracks?: Track[]; tracks_label?: string;
}

interface Props { sessions: Session[] }
const { sessions } = Astro.props;

// A session's colour IS its availability — same encoding as the bar above, so
// the reader learns one legend and it holds for the whole page.
const rows = sessions.map((s) => ({
  ...s,
  state: s.state ?? 'locked',
  isGap: s.note === 'gap',
  start: s.from ? toDisplayTime(s.from) : null,
  end: s.to ? toDisplayTime(s.to) : null,
}));
---

<ol class="diary-timeline">
  {rows.map((s) => (
    <li class={`row row--${s.state}${s.isGap ? ' row--gap' : ''}`}>
      <div class="t">
        {s.start && <span class="start">{s.start}</span>}
        {s.end && <span class="end">– {s.end}</span>}
      </div>
      <div class="what">
        <p class="title">{s.title}</p>
        {s.desc && <p class="desc">{s.desc}</p>}
        {(s.room || s.kind) && (
          <div class="meta">
            {s.room && <span class="room">{s.room}</span>}
            {s.kind && <span class="kind">{s.kind}</span>}
          </div>
        )}
        {s.speakers && s.speakers.length > 0 && (
          <ul class="speakers">
            {s.speakers.map((p) => (
              <li>{p.name}{p.org && <span> · {p.org}</span>}</li>
            ))}
          </ul>
        )}
        {s.tracks && s.tracks.length > 0 && (
          <div class="concurrent">
            <span class="concurrent-label">{s.tracks_label ?? 'Concurrent — pick one'}</span>
            <ul class="tracks">
              {s.tracks.map((tr) => (
                <li class="track">
                  <p class="track-title">{tr.title}</p>
                  {tr.desc && <p class="desc">{tr.desc}</p>}
                  {(tr.room || tr.kind) && (
                    <div class="meta">
                      {tr.room && <span class="room">{tr.room}</span>}
                      {tr.kind && <span class="kind">{tr.kind}</span>}
                    </div>
                  )}
                  {tr.speakers && tr.speakers.length > 0 && (
                    <ul class="speakers">
                      {tr.speakers.map((p) => (
                        <li>{p.name}{p.org && <span> · {p.org}</span>}</li>
                      ))}
                      {tr.more && <li class="more">{tr.more}</li>}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .diary-timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.35rem;
    position: relative;
  }
  .diary-timeline::before {
    content: "";
    position: absolute;
    left: 0.28rem; top: 0.9rem; bottom: 0.9rem;
    width: 1px;
    background: var(--border);
  }

  .row {
    position: relative;
    padding: 0.5rem 0;
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 1rem;
  }
  .row::before {
    content: "";
    position: absolute;
    left: -1.35rem; top: 1.05rem;
    width: 7px; height: 7px;
    border-radius: 50%;
  }
  .row--locked::before { background: var(--diary-locked); }
  .row--open::before   { background: var(--diary-open); }
  .row--gap::before    { background: transparent; border: 1px dashed var(--muted-foreground); }

  .t { font-size: 0.9rem; line-height: 1.35; padding-top: 0.12rem; font-variant-numeric: tabular-nums; }
  .t .start { display: block; }
  .t .end { display: block; font-size: 0.82rem; color: var(--muted-foreground); }
  .row--locked .t .start { color: var(--diary-locked); }
  .row--open .t .start { color: var(--diary-open); }

  .what { min-width: 0; }
  .title { margin: 0; font-weight: 620; font-size: 1rem; line-height: 1.45; }
  .row--gap .title { font-weight: 400; font-style: italic; color: var(--muted-foreground); }
  .desc { margin: 0.25rem 0 0; font-size: 0.92rem; line-height: 1.6; color: var(--muted-foreground); }

  .meta {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0.35rem 0.7rem; margin-top: 0.35rem;
    font-size: 0.8rem; color: var(--muted-foreground);
  }
  .room::before { content: "📍 "; }
  .kind {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 0.55rem;
    font-size: 0.67rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .speakers { list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.5rem 0 0; padding: 0; }
  .speakers li {
    background: color-mix(in srgb, var(--muted) 55%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.12rem 0.7rem;
    font-size: 0.8rem;
  }
  .speakers li span { color: var(--muted-foreground); }
  .speakers li.more { border-style: dashed; color: var(--muted-foreground); background: none; }

  .concurrent {
    border: 1px dashed var(--border);
    border-radius: var(--radius-md, 0.5rem);
    padding: 0.8rem 0.95rem 0.9rem;
    margin-top: 0.5rem;
  }
  .concurrent-label {
    display: block;
    font-size: 0.67rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--diary-free);
    margin-bottom: 0.65rem;
  }
  .tracks { list-style: none; display: grid; gap: 0.7rem; margin: 0; padding: 0; }
  .track {
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 0.375rem);
    padding: 0.65rem 0.8rem 0.75rem;
  }
  .track-title { margin: 0; font-weight: 600; font-size: 0.95rem; }

  @media (max-width: 34rem) {
    .row { grid-template-columns: 1fr; gap: 0.15rem; }
    .row::before { top: 0.95rem; }
    .t { display: flex; gap: 0.4rem; align-items: baseline; }
    .t .start, .t .end { display: inline; }
  }
</style>
