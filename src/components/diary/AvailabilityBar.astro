---
import { spanPercent, assertBandsCover, axisTicks, BAND_COPY, toDisplayTime } from '../../lib/diary/schedule';
import type { Band, Window } from '../../lib/diary/schedule';

interface Props {
  window: Window;
  bands: Band[];
  dayLabel: string;
}

const { window: win, bands, dayLabel } = Astro.props;

// Throws at build time on a schedule that doesn't tile the window. A bar with a
// hole in it still looks like a bar, which is exactly why this can't be a warning.
assertBandsCover(win, bands, dayLabel);

const segments = bands.map((band) => ({
  ...band,
  percent: spanPercent(win, band.from, band.to),
  tooltip: `${toDisplayTime(band.from)} – ${toDisplayTime(band.to)} · ${band.label ?? BAND_COPY[band.state]}`,
}));

const ticks = axisTicks(win, 2);
---

<div class="diary-bar-wrap">
  <div class="diary-bar" role="img" aria-label={`Availability for ${dayLabel}`}>
    {segments.map((seg) => (
      <span class={`seg seg--${seg.state}`} style={`width:${seg.percent}%`} title={seg.tooltip}></span>
    ))}
  </div>
  {/* Absolutely placed at true fractions rather than flex-distributed: an
      intrinsic-width final label steals space from the other slots and walks
      every mark leftward, which misreads the bar by up to half an hour. */}
  <div class="diary-ticks" aria-hidden="true">
    {ticks.map((tick, i) => (
      <span
        class={i === ticks.length - 1 ? 'tick tick--last' : 'tick'}
        style={i === ticks.length - 1 ? undefined : `left:${tick.percent}%`}
      >{tick.label}</span>
    ))}
  </div>
</div>

<style>
  .diary-bar-wrap { width: 100%; }

  .diary-bar {
    display: flex;
    width: 100%;
    height: 2.1rem;
    border-radius: var(--radius-sm, 0.375rem);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .diary-bar .seg { display: block; height: 100%; }
  /* Hairline between neighbours so two same-coloured bands stay countable. */
  .diary-bar .seg + .seg { box-shadow: inset 1px 0 0 var(--background); }

  .seg--locked  { background: color-mix(in srgb, var(--diary-locked) 80%, transparent); }
  .seg--open    { background: color-mix(in srgb, var(--diary-open) 68%, transparent); }
  .seg--free    { background: color-mix(in srgb, var(--diary-free) 60%, transparent); }
  .seg--transit { background: color-mix(in srgb, var(--muted-foreground) 22%, transparent); }

  .diary-ticks {
    position: relative;
    height: 1rem;
    margin-top: 0.25rem;
    font-size: 0.68rem;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
  .diary-ticks .tick { position: absolute; top: 0; white-space: nowrap; }
  .diary-ticks .tick--last { right: 0; }

  @media (max-width: 34rem) {
    .diary-bar { height: 1.7rem; }
    .diary-ticks { font-size: 0.6rem; }
  }
</style>
