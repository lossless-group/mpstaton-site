---
import type { Opportunity } from '../../lib/promote/types';

interface Props {
  opportunity: Opportunity;
}

const { opportunity } = Astro.props;
const symbol = opportunity.logo?.symbol;
---
<div class="flex flex-col items-center text-center gap-3 py-12">
  {symbol && (
    <img src={symbol} alt="" class="h-12 w-12 opacity-90" />
  )}
  <div class="flex items-baseline justify-center gap-3">
    <span class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Promoting</span>
    <span class="text-3xl font-semibold tracking-tight text-foreground">{opportunity.company_name}</span>
  </div>
  {opportunity.eyebrow && (
    <p class="text-sm text-muted-foreground">{opportunity.eyebrow}</p>
  )}
</div>
